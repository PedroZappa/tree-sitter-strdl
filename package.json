{
  "name": "tree-sitter-strudel",
  "type": "commonjs",
  "version": "1.5.0",
  "description": "Parser for Strudel, a Tidal Cycles based live coding tool",
  "repository": "https://github.com/PedroZappa/tree-sitter-strdl",
  "license": "AGPL-3.0-only",
  "author": {
    "name": "Zedro",
    "email": "45104292+PedroZappa@users.noreply.github.com ",
    "url": "https://www.pedrozappa.com/"
  },
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "strudel"
  ],
  "files": [
    "grammar.js",
    "tree-sitter.json",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/grammar.json",
    "src/node-types.json",
    "src/parser.c",
    "src/tree_sitter/",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.3.1",
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "prebuildify": "^6.0.1",
    "prettier": "3.10.1",
    "tree-sitter": "^0.25.0",
    "tree-sitter-cli": "0.27.2"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js",
    "local_install": "./scripts/local_install.sh"
  },
  "tree-sitter": [
    {
      "scope": "source.strdl",
      "file-types": [
        "strdl",
        "strudel"
      ],
      "highlights": [
        "queries/highlights.scm"
      ],
      "locals": [
        "queries/locals.scm"
      ]
    }
  ]
}
